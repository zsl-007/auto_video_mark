# ===== 运行时数据目录（大文件 + 可能含隐私数据）=====
input/
output/
workdir/
db/

# ===== 模型权重（体积大，建议单独分发）=====
models/*.pt
models/*.onnx
models/*.pth

# ===== 环境与密钥 =====
.env
.env.*
!.env.example
.venv/
venv/
env/

